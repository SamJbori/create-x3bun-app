{
  "name": "x3bun",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo run dev",
    "exports": "turbo run exports",
    "format": "bunx @biomejs/biome@latest format .",
    "format:fix": "bunx @biomejs/biome@latest format . --write",
    "lint": "bunx @biomejs/biome@latest check .",
    "lint:fix": "bunx @biomejs/biome@latest check --write .",
    "lint:ws": "bunx --bun sherif@latest",
    "lint:ws:fix": "bunx --bun sherif@latest --fix",
    "typecheck": "turbo run typecheck",
    "postinstall": "bun run --bun turbo/scripts/postinstall.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22",
    "bun": "1.4.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
