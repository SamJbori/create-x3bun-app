{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/app/**/*",
			"**/.vscode/**/*",
			"!**/index.html",
			"**/vite.config.ts",
			"**/tsconfig.ts",
			"**/*.json",
			"!**/app/routeTree.gen.ts",
			"!**/app/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": { "noNonNullAssertedOptionalChain": "info" },
			"a11y": {
				"useSemanticElements": "warn",
				"useKeyWithClickEvents": "warn"
			},
			"nursery": {
				"noUndeclaredEnvVars": "error",
				"useAwaitThenable": "warn",
				"noFloatingPromises": "error"
			},

			"style": {
				"noNonNullAssertion": "info",
				"noProcessEnv": "error",
				"useNodejsImportProtocol": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"zod": {
								"message": "Use \"zod/v4\" instead",
								"allowImportNames": ["zod/v4"]
							}
						}
					}
				},
				"useImportType": {
					"level": "error",
					"options": {
						"style": "separatedType"
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		},
		"linter": {
			"enabled": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"recommended": true,
				"useSortedInterfaceMembers": "on",
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [{ "type": true }]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/env/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off"
					}
				}
			}
		}
	]
}
