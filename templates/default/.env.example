# Production Database
DATABASE_URL="mongodb+srv://<username>:<password>@<DBName>:<SomePort>/<DBName>?appName=<SomeApp>"

# Better auth url
BETTER_AUTH_URL="http://localhost:3000"
# Better auth secret, generate with `bunx --bun @better-auth/cli secret`
BETTER_AUTH_SECRET="somelongandcomplicatedencryptionkeythatwillbeusedbybetterauthforencryptingcredintials"
# Better auth Mongo DB URL
AUTH_DB_URL=$DATABASE_URL
# Better auth Table name
AUTH_TABLE_NAME="auth"

# S3 Config, EP can be undefined
# S3_ENDPOINT="https://some.string.com"
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# For SSR communication
SERVER_TOKEN=""

# CloudFlare Turnstile Secret Key
CF_TURNSTILE_SECRET_KEY="vvv"

# Backend Server Address
X3BUN_BE_URL="http://localhost:3006"

# For preventing direct/unproxied API requests
PROXY_SECRET=somelongandcomplicatedencryptionkeythatwillbeusedtopreventdirectcallstoapiendpoint

# For cross origin 
DOMAIN_NAME=localhost